APP_ENV=development

# ---------------------------------------------------------------------------
# Azure OpenAI
# Authentication: DefaultAzureCredential (Managed Identity / az login) is used
# when AZURE_OPENAI_API_KEY is empty. Provide a key only for local fallback.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Azure AI Search
# Authentication: DefaultAzureCredential is used when AZURE_SEARCH_API_KEY is
# empty. Provide a key only for local fallback.
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=abc-pharma-products
AZURE_SEARCH_SEMANTIC_CONFIG=abc-pharma-semantic

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
SOURCE_REGISTRY_PATH=sources/sources.json
DATA_DIR=data/sources

TOP_K=5
VECTOR_TOP_K=10
SEMANTIC_TOP_K=5

# CORS origins (comma separated) for the frontend dev server
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Application Insights connection string
APPLICATIONINSIGHTS_CONNECTION_STRING=
